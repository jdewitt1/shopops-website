<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Primary Meta Tags -->
  <title>ShopOps — Your Shopify Ops Team</title>
  <meta name="description" content="ShopOps provides on-demand, white-glove Shopify support with token-based PopCoins and a Kanban task view—no learning curve required.">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://www.shopops.app/">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://www.shopops.app/">
  <meta property="og:title" content="ShopOps — Your Shopify Ops Team">
  <meta property="og:description" content="Delegate Shopify tasks easily with PopCoins—on-demand support, transparent pricing, and real people behind every task.">
  <meta property="og:image" content="https://www.shopops.app/ShopOpsLogo.png">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content="https://www.shopops.app/">
  <meta name="twitter:title" content="ShopOps — Your Shopify Ops Team">
  <meta name="twitter:description" content="Delegate Shopify tasks easily with PopCoins—on-demand support, transparent pricing, and real people behind every task.">
  <meta name="twitter:image" content="https://www.shopops.app/ShopOpsLogo.png">

  <!-- Structured Data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "ShopOps",
    "url": "https://www.shopops.app/",
    "logo": "https://www.shopops.app/ShopOpsLogo.png",
    "description": "On-demand Shopify support service with PopCoins token-based system and Kanban task tracking.",
    "areaServed": "Worldwide",
    "brand": "ShopOps"
  }
  </script>

  <!-- Stylesheet -->
  <link href="styles.css" rel="stylesheet">

  <!-- Heyflow widget -->
  <script async src="https://assets.prd.heyflow.com/builder/widget/latest/webview.js"></script>
</head>
<body>
  <header>
    <img src="ShopOpsLogo.png" alt="ShopOps Logo" class="logo">
    <h1>Your Shopify Ops Team—No Learning Curve, Just Results.</h1>
    <p>Delegate your Shopify store's technical and operational tasks with ease. ShopOps is the all-in-one support service and client portal that gives you a white-glove experience, without the guesswork.</p>
    <a href="#cta" class="btn">Get 5 Free PopCoins</a>
  </header>
  <main>
    <section class="stack-section" id="problem">
      <h2>The Problem</h2>
      <p>Running a Shopify store means juggling products, promotions, apps, and backend headaches—on top of actually growing your business.</p>
      <p>Shopify’s support gives you a chat box. We give you a team.</p>
    </section>

    <section class="stack-section" id="delivers">
      <h2>What ShopOps Delivers</h2>
      <ul>
        <li>On-Demand Shopify Support via email, voice memo, chat, or portal</li>
        <li>PopCoins token system instead of hourly billing</li>
        <li>Kanban Task View: Triage → Solve → Verify → Complete</li>
        <li>In-store app you keep—even if you cancel support</li>
        <li>Free app install; pay only for PopCoins subscriptions</li>
        <li>Scalable, white-glove digital marketing services</li>
      </ul>
    </section>

    <section class="stack-section" id="how-it-works">
      <h2>How It Works</h2>
      <ol>
        <li><strong>Start Free:</strong> Get 5 PopCoins risk-free</li>
        <li><strong>Submit a Task:</strong> Email, upload, or message your request</li>
        <li><strong>We Handle It:</strong> Our experts complete the work</li>
        <li><strong>Track Progress:</strong> Monitor status, token usage, and outcomes</li>
      </ol>
    </section>

    <section class="stack-section" id="tasks">
      <h2>What You Can Get Done</h2>
      <h3>1 PopCoin Tasks (Quick/Light)</h3>
      <ul>
        <li>Edit product titles, tags, prices</li>
        <li>Set up a simple discount code</li>
        <li>Upload a banner image or update homepage text</li>
        <li>Change navigation menu item</li>
        <li>Modify a metafield value</li>
        <li>Update store policies</li>
      </ul>
      <h3>2 PopCoin Tasks (Medium/Setup)</h3>
      <ul>
        <li>Bulk product import via CSV</li>
        <li>App installation and basic setup (e.g. reviews, upsells)</li>
        <li>Set up custom collections</li>
        <li>Add homepage sections or configure theme blocks</li>
        <li>Set up a basic automation (Shopify Flow or similar)</li>
        <li>Update shipping settings or rules</li>
      </ul>
      <h3>3 PopCoin Tasks (Complex/Custom)</h3>
      <ul>
        <li>Theme customization (CSS, Liquid changes)</li>
        <li>Custom page template or product layout edits</li>
        <li>Advanced app configurations or integrations</li>
        <li>Product filter setup via metafields</li>
        <li>Store speed/performance audit</li>
        <li>Subscription setup (Recharge, etc.)</li>
      </ul>
    </section>

    <section class="stack-section" id="pricing">
      <h2>Pricing</h2>
      <div class="pricing-tier"><strong>Starter:</strong> $500/mo — 20 PopCoins</div>
      <div class="pricing-tier"><strong>Growth:</strong> $900/mo — 40 PopCoins</div>
      <div class="pricing-tier"><strong>Scale:</strong> $1500/mo — 70 PopCoins</div>
      <p>Add-on PopCoins available. Cancel anytime.</p>
    </section>

    <section class="stack-section" id="for-whom">
      <h2>Who It’s For</h2>
      <ul>
        <li>Merchants needing reliable store changes</li>
        <li>Teams preferring delegation over DIY</li>
        <li>Growing businesses requiring proactive support</li>
      </ul>
    </section>

    <section class="stack-section" id="app-preview">
      <h2>Shopify App — Coming Soon</h2>
      <p>Access your PopCoins balance and task board right inside Shopify Admin.</p>
      <figure>
        <img src="shopify-app-screenshot.png" alt="ShopOps App UI" style="width:100%; border-radius:12px; box-shadow:0 8px 20px rgba(0,0,0,0.1);">
        <figcaption>Preview of the upcoming ShopOps Shopify App.</figcaption>
      </figure>
    </section>

    <div class="cta-wrapper">
      <section class="stack-section cta" id="cta">
        <h2>Try ShopOps Free — Get 5 PopCoins Today</h2>
        <button class="btn" onclick="window.dispatchEvent(new CustomEvent('heyflow-modal-element:open',{detail:{modalId:'I7__GpbuDm'}}));">
          Start Now
        </button>
        <p style="margin-top:20px;font-size:0.95rem;color:#555;">Powered by real people. Built for real growth.<br>Your Shopify back office, managed.</p>
      </section>
    </div>
  </main>

  <!-- Heyflow Modal -->
  <heyflow-modal-element modal-id="I7__GpbuDm">
    <heyflow-wrapper flow-id="ONczn56DlynlyKpo0YHq" dynamic-height scroll-up-on-navigation style-config='{"width":"800px","borderRadius":"16px"}' modal-id="I7__GpbuDm"></heyflow-wrapper>
  </heyflow-modal-element>

  <script>
    /* Blur & opacity on scroll */
    const elems = [document.querySelector('header'), ...document.querySelectorAll('.stack-section')];
    const updateEffects = () => {
      elems.forEach((el, i) => {
        const next = elems[i + 1];
        if (next) {
          const rect = el.getBoundingClientRect();
          const nextRect = next.getBoundingClientRect();
          const overlap = Math.min(Math.max(rect.bottom - nextRect.top, 0), rect.height);
          const ratio = overlap / rect.height;
          el.style.filter = `blur(${ratio * 3}px)`;
          el.style.opacity = `${1 - ratio * 0.9}`;
        } else {
          el.style.filter = el.style.opacity = '';
        }
      });
    };
    window.addEventListener('scroll', updateEffects);
    window.addEventListener('resize', updateEffects);
    document.addEventListener('DOMContentLoaded', updateEffects);
  </script>
</body>
</html>
